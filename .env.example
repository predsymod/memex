# Placeholders only. Real values live in Supabase secrets, never in this repo.
# Copy this file to .env (git-ignored), fill it in, then run: supabase secrets set --env-file .env

# Used by scripts/doctor.mjs (and by you): where your Memex server lives. No key in it.
MEMEX_URL=https://<your-project-ref>.supabase.co/functions/v1/memex-mcp

# The access key every client sends (generate it with scripts/generate-key.sh or scripts/generate-key.ps1). Required.
MCP_ACCESS_KEY=
# Optional, advanced: one key per client as name:key pairs instead of one shared key. The name becomes the `source`
# of what that client writes, and removing a pair revokes just that client. Supabase secrets can't be read back,
# so keep the full list here (this file is gitignored) and re-set it on change. Leave commented out otherwise.
# MCP_ACCESS_KEYS=claude:<key>,codex:<key>,muse:<key>

# Limits for scheduled syncs that save without a person approving each run. Defaults shown; optional.
# UNATTENDED_MAX_ITEMS is notes per run (1 to 50), UNATTENDED_MAX_CHARS is the length of each note (100 to 5000).
UNATTENDED_MAX_ITEMS=10
UNATTENDED_MAX_CHARS=1000
# An unattended save at least this similar (0.5 to 0.99) to something that agent already saved automatically, or that
# you retracted, is skipped as a repeat. Lower skips more, higher lets more through. Corrections are exempt.
UNATTENDED_REPEAT_SIMILARITY=0.85

# Set to true only if a client can pass the key in the URL (?key=...) and nothing else. URLs appear in server logs.
ALLOW_URL_KEY=false

# Embeddings (OpenRouter). Required.
OPENROUTER_API_KEY=

# Dreaming (optional). Providers are tried in order; a provider with no key is skipped, and an error falls through.
# Meta Model API key from https://dev.meta.ai (leave commented out to skip Meta; the OpenRouter fallback below still works)
# META_API_KEY=
# Optional; defaults to https://api.meta.ai/v1
# META_API_BASE=
META_MODEL=muse-spark-1.3
# Topic overviews that Dreaming writes. Defaults shown; all optional.
# DREAM_SYNTHESIS=off turns them off. DREAM_MAX_SYNTHESES is how many are written or refreshed per run (0 to 20),
# DREAM_MIN_CLUSTER is notes needed before a topic gets one (2 to 20), DREAM_MIN_REFRESH_NEW is new notes needed
# before an existing overview is rewritten (1 to 20).
DREAM_SYNTHESIS=on
DREAM_MAX_SYNTHESES=3
DREAM_MIN_CLUSTER=4
DREAM_MIN_REFRESH_NEW=2
# Fallback uses OPENROUTER_API_KEY above.
DREAM_PROVIDERS=meta,openrouter
DREAM_FALLBACK_MODEL=openai/gpt-4o-mini

# Reasoning effort for Dreaming's model. minimal is about 5x cheaper and 4x faster than the default with the same results on tests.
META_REASONING_EFFORT=minimal
